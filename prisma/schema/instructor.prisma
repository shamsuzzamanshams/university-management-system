model Instructor {
  id           String     @id @default(uuid())
  userId       String     @unique
  employeeId   String     @unique
  designation  String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections     Section[]

  @@map("instructor")
}
