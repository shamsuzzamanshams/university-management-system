model Attendance {
  id        String           @id @default(uuid())
  date      DateTime
  status    AttendanceStatus
  studentId String
  sectionId String
  remarks   String?
  section   Section          @relation(fields: [sectionId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, sectionId, date])
  @@map("attendance")
}
