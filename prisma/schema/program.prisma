model Program {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  durationYrs  Int
  totalCredits Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  students     Student[]
  courses      Course[]   @relation("ProgramCourses")


  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt()

  @@map("program")
}
