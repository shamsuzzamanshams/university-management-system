model StudentFee {
  id          String    @id @default(uuid())
  amount      Decimal   @db.Decimal(10, 2)
  dueDate     DateTime
  status      FeeStatus @default(UNPAID)
  paidAt      DateTime?
  description String    // e.g., "Tuition Fee Fall 2026"
  studentId   String
  currency String  @default("BDT")

  paymentGetway         String @default("bkash")
  merchantInvoiceNumber String @unique // appointment id

  bkashPaymentId String? @unique
  bkashTrxId     String?
  payerReference String?
  student     Student   @relation(fields: [studentId], references: [id])
  semesterId  String
  semester    Semester  @relation(fields: [semesterId], references: [id])

  @@map("studentFee")
}