model AcademicResult {
  id                 String  @id @default(uuid())
  studentId          String
  semesterCode       String
  gpa                Float
  cgpa               Float
  totalCreditsEarned Float
  remarks            String?
  student            Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, semesterCode])
  @@map("academicResult")
}
