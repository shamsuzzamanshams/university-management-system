model Section {
  id           String       @id @default(uuid())
  name         String
  capacity     Int
  roomNumber   String?
  schedule     String
  semesterId   String
  instructorId String
  attendances  Attendance[]
  exams        Exam[]
  instructor   Instructor   @relation(fields: [instructorId], references: [id])

  @@unique([semesterId, name])
  @@map("section")
}
